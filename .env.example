# --- OpenSearch (audit log storage) ---
OPENSEARCH_HOST=
OPENSEARCH_PORT=443
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
AUDIT_INDEX_NAME=agent-audit-log

# --- Omniroute (OpenAI-compatible proxy, used for reliable tool-calling) ---
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL_ID=

# --- Amazon Bedrock (via teammate's AWS account) ---
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_REGION=
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# --- Ollama (local fallback model, no credentials needed) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=hf.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q8_0

# --- Provider override (optional) ---
# Leave blank to auto-detect: Bedrock > Omniroute > Ollama.
# Set to "bedrock", "omniroute", or "ollama" to force a specific provider.
MODEL_PROVIDER=
